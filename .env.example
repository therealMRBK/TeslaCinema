# Copy to .env (./setup.sh does it for you and generates the password).

# --- Login (required) ---
AUTH_USER=cinema
AUTH_PASSWORD=change-me-to-something-long

# --- Where it listens on the host ---
# 127.0.0.1 = only this machine (use with caddy / cloudflared / your own reverse proxy).
# 0.0.0.0   = also on your home network, plain http (handy for a first test; the car needs https, see docs/).
BIND_ADDRESS=127.0.0.1
HOST_PORT=8195

# --- Language ---
# UTF-8 locale of the container; also the language of Chrome's menus. Available: en_US de_DE fr_FR es_ES it_IT nl_NL
# pt_BR pl_PL tr_TR sv_SE da_DK nb_NO fi_FI cs_CZ (each with .UTF-8)
LOCALE=en_US.UTF-8

# --- Picture quality ---
# The virtual screen follows the size of the browser window that opens the page, these are only the start values.
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
# Video bitrate of the stream and its frame rate. The car's mobile connection is often 2-6 Mbit/s: lower the bitrate
# (e.g. 2000k) if the picture stutters, raise it (e.g. 6000k) on a fast connection.
AV_BITRATE=3500k
AV_FPS=30

# --- HTTPS front ends (only for the matching compose profile) ---
# profile "caddy": the domain that points at this machine, ports 80 and 443 must reach it
DOMAIN=
# profile "cloudflared-token": the token of your named Cloudflare tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# --- Advanced (rarely needed) ---
# Chrome's UI language if it should differ from LOCALE, e.g. de or en-GB
CHROME_LANG=
# How far (ms) the picture may fall behind before the stream jumps to the newest frame
AV_MAX_BEHIND_MS=400
# Set to 1 ONLY if something else in front of TeslaCinema does the login (then AUTH_PASSWORD may stay empty)
ALLOW_NO_AUTH=0
